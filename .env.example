# Copy to .env and fill in real values. Never commit .env (it's gitignored).
# Load it into your shell before running approval commands, e.g.:
#   set -a; source .env; set +a
#   python3 -m scout.cli request-approval <candidate_id>

# Bot token from @BotFather (Telegram)
TELEGRAM_BOT_TOKEN=

# Chat/user id the approval request messages are sent to
TELEGRAM_CHAT_ID=

# Shared secret Telegram echoes back in the
# X-Telegram-Bot-Api-Secret-Token header on every webhook call -- pick any
# long random string yourself, it is not issued by Telegram
TELEGRAM_WEBHOOK_SECRET=

# --- PUBLISH (scout.cli publish) ---
# only needed for the platforms you actually publish to; naver_blog needs
# no credentials (it always returns NOT_SUPPORTED, see scout/publish.py)

# Meta Graph API token with the threads_content_publish scope, and the
# Threads user id it was issued for. Requires Tech Provider Verification.
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# Google Cloud OAuth2 client for the YouTube Data API v3, plus a refresh
# token already granted the youtube.upload scope
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
